{
  "name": "@resume/schemas",
  "version": "1.0.0",
  "description": "Runtime validation schemas (Zod) for the resume monorepo. Types are inferred from schemas to prevent drift with @resume/types.",
  "private": true,
  "type": "module",
  "main": "./src/index.js",
  "scripts": {
    "build:cjs": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=dist/index.cjs --external:zod",
    "prepare": "npm run build:cjs",
    "test": "node --test 'src/__tests__/**/*.test.js'"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    },
    "./application": "./src/application.js",
    "./resume": "./src/resume.js",
    "./auth": "./src/auth.js",
    "./webhook": "./src/webhook.js",
    "./common": "./src/common.js",
    "./portfolio": "./src/portfolio.js"
  },
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
