{
  "name": "@resume/job-automation",
  "version": "1.4.0",
  "description": "MCP Server for Wanted Korea job platform (원티드)",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "wanted-resume": "src/cli.js"
  },
  "scripts": {
    "build": "echo 'Pure ESM - no build required'",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test 'src/shared/**/*.test.js' 'src/sync/__tests__/*.test.js' 'src/auto-apply/__tests__/queue-apply.test.js' 'src/auto-apply/__tests__/auto-apply.e2e.test.js' 'src/auto-apply/__tests__/submission-flow.test.js' 'src/auto-apply/cli/__tests__/*.test.js' 'src/auto-apply/cli/handlers/__tests__/*.test.js' 'src/auto-apply/strategies/__tests__/retry-behavior.test.js' 'src/auto-apply/strategies/__tests__/wanted-job-id-validation.test.js' 'src/tools/__tests__/*.test.js' 'src/tools/**/__tests__/*.test.js' 'src/session-broker/**/*.test.js' 'scripts/profile-sync/__tests__/*.test.js' 'scripts/profile-sync-cli/__tests__/*.test.js' 'scripts/jobkorea-session/__tests__/*.test.js' 'scripts/pipeline/search.test.js' 'scripts/__tests__/*.test.js' 'platforms/**/__tests__/*.test.js' 'src/test-helpers/__tests__/*.test.js' 'src/server/__tests__/server.test.js' 'src/server/__tests__/automation-webhook.test.js' 'src/server/middleware/__tests__/error-handler.test.js' 'src/server/routes/__tests__/auth-route-registration.test.js' 'src/server/routes/__tests__/auto-apply.routes.test.js'",
    "test:all": "node --test 'src/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'src/shared/**/*.test.js'",
    "test:external": "node --test 'src/e2e.test.js' 'src/pipeline.test.js' 'src/auto-apply/strategies/__tests__/jobkorea-strategy.test.js' 'src/auto-apply/strategies/__tests__/saramin-strategy.test.js' # excluded from `npm test`: e2e.test.js and pipeline.test.js require a live Wanted session/login (network + real credentials, run wanted_auth first); jobkorea-strategy.test.js and saramin-strategy.test.js use real un-mocked timers (40s-90s+ per run) and saramin-strategy.test.js additionally has pre-existing failing assertions (message-check ordering mismatch between test and source, unrelated to this fix) -- run manually, do not wire into CI",
    "test:e2e": "node src/e2e.test.js",
    "test:pipeline": "node src/pipeline.test.js",
    "cli": "node src/cli.js",
    "export": "node src/cli.js export",
    "sync": "node src/cli.js sync",
    "pipeline": "node src/cli.js pipeline",
    "get-cookies": "node scripts/get-cookies.js",
    "dashboard": "node src/server/index.js",
    "dashboard:dev": "node --watch src/server/index.js",
    "server": "node src/server/index.js",
    "server:dev": "node --watch src/server/index.js",
    "auto-apply": "node src/auto-apply/cli/index.js apply --apply",
    "auto-apply:dry": "node src/auto-apply/cli/index.js apply",
    "sync:platforms": "node platforms/sync-platforms.js",
    "sync:platforms:status": "node platforms/sync-platforms.js status",
    "sync:platforms:preview": "node platforms/sync-platforms.js preview",
    "auto": "node scripts/auto-all.js",
    "auto:sync": "node scripts/auto-all.js --sync",
    "auto:verify": "node scripts/auto-all.js --verify",
    "ops:daily-run": "go run ./scripts/ops/auto-daily-run/main.go",
    "ops:monitor": "go run ./scripts/ops/auto-monitor/main.go",
    "ops:maintenance": "GO111MODULE=off go run ./scripts/ops/auto-maintenance",
    "cookies:extract": "node scripts/extract-cookies-cdp.js",
    "cookies:import": "node scripts/import-cookies-manual.js",
    "jobkorea:har:capture": "node scripts/profile-sync/jobkorea-handler/har-capture-cli.js --apply --include-save --include-portfolio",
    "jobkorea:har:capture:dry": "node scripts/profile-sync/jobkorea-handler/har-capture-cli.js --dry-run",
    "jobkorea:har:sanitize": "node scripts/profile-sync/jobkorea-handler/har-tools-cli.js sanitize",
    "jobkorea:har:analyze": "node scripts/profile-sync/jobkorea-handler/har-tools-cli.js analyze",
    "jobkorea:sync": "env JOBKOREA_SYNC_MODE=hybrid-api node scripts/profile-sync.js jobkorea --apply",
    "jobkorea:sync:dry": "env JOBKOREA_SYNC_MODE=api-dry-run node scripts/profile-sync.js jobkorea --diff",
    "jobkorea:api:test": "node --test 'scripts/profile-sync/__tests__/jobkorea-api-client.test.js' 'scripts/profile-sync/__tests__/jobkorea-api-payload.test.js'",
    "jobkorea:sync:hybrid:test": "node --test 'scripts/profile-sync/__tests__/jobkorea-sync-hybrid.test.js'",
    "jobkorea:test:all": "node --test 'scripts/profile-sync/__tests__/jobkorea-*.test.js'"
  },
  "keywords": [
    "mcp",
    "wanted",
    "job",
    "korea",
    "채용"
  ],
  "author": "jclee",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@resume/data": "*",
    "@resume/schemas": "*",
    "@resume/shared": "*",
    "@resume/types": "*",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "google-auth-library": "^10.9.1",
    "googleapis": "^173.0.0",
    "node-fetch": "^3.3.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0"
  },
  "optionalDependencies": {
    "@cloudflare/puppeteer": "^1.0.6"
  },
  "devDependencies": {
    "better-sqlite3": "^13.0.1",
    "playwright": "^1.58.2",
    "puppeteer": "25.4.0",
    "ws": "^8.21.1"
  }
}
