{
  "name": "@resume/job-automation",
  "version": "1.4.0",
  "description": "MCP Server for Wanted Korea job platform (원티드)",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "wanted-resume": "src/cli.js"
  },
  "scripts": {
    "build": "echo 'Pure ESM - no build required'",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node --test 'src/shared/**/*.test.js' 'src/auto-apply/__tests__/queue-apply.test.js' 'src/auto-apply/cli/__tests__/*.test.js' 'src/auto-apply/cli/handlers/__tests__/*.test.js' 'src/auto-apply/strategies/__tests__/retry-behavior.test.js' 'src/auto-apply/strategies/__tests__/wanted-job-id-validation.test.js' 'src/tools/__tests__/*.test.js' 'src/tools/**/__tests__/*.test.js' 'src/session-broker/**/*.test.js' 'scripts/profile-sync/__tests__/*.test.js' 'scripts/__tests__/*.test.js' 'platforms/**/__tests__/*.test.js' 'src/test-helpers/__tests__/*.test.js'",
    "test:all": "node --test 'src/**/*.test.js'",
    "test:coverage": "node --test --experimental-test-coverage 'src/shared/**/*.test.js'",
    "test:e2e": "node src/e2e.test.js",
    "test:pipeline": "node src/pipeline.test.js",
    "cli": "node src/cli.js",
    "export": "node src/cli.js export",
    "sync": "node src/cli.js sync",
    "pipeline": "node src/cli.js pipeline",
    "get-cookies": "node scripts/get-cookies.js",
    "dashboard": "node src/server/index.js",
    "dashboard:dev": "node --watch src/server/index.js",
    "server": "node src/server/index.js",
    "server:dev": "node --watch src/server/index.js",
    "auto-apply": "node src/auto-apply/cli/index.js apply --apply",
    "auto-apply:dry": "node src/auto-apply/cli/index.js apply",
    "sync:platforms": "node platforms/sync-platforms.js",
    "sync:platforms:status": "node platforms/sync-platforms.js status",
    "sync:platforms:preview": "node platforms/sync-platforms.js preview",
    "auto": "node scripts/auto-all.js",
    "auto:sync": "node scripts/auto-all.js --sync",
    "auto:verify": "node scripts/auto-all.js --verify",
    "ops:daily-run": "go run ./scripts/ops/auto-daily-run/main.go",
    "ops:monitor": "go run ./scripts/ops/auto-monitor/main.go",
    "ops:maintenance": "GO111MODULE=off go run ./scripts/ops/auto-maintenance",
    "cookies:extract": "node scripts/extract-cookies-cdp.js",
    "cookies:import": "node scripts/import-cookies-manual.js",
    "jobkorea:har:capture": "node scripts/profile-sync/jobkorea-handler/har-capture-cli.js --apply --include-save --include-portfolio",
    "jobkorea:har:capture:dry": "node scripts/profile-sync/jobkorea-handler/har-capture-cli.js --dry-run",
    "jobkorea:har:sanitize": "node scripts/profile-sync/jobkorea-handler/har-tools-cli.js sanitize",
    "jobkorea:har:analyze": "node scripts/profile-sync/jobkorea-handler/har-tools-cli.js analyze",
    "jobkorea:api:test": "node --test 'scripts/profile-sync/__tests__/jobkorea-api-client.test.js' 'scripts/profile-sync/__tests__/jobkorea-api-payload.test.js'",
    "jobkorea:sync:hybrid:test": "node --test 'scripts/profile-sync/__tests__/jobkorea-sync-hybrid.test.js'",
    "jobkorea:test:all": "node --test 'scripts/profile-sync/__tests__/jobkorea-*.test.js'"
  },
  "keywords": [
    "mcp",
    "wanted",
    "job",
    "korea",
    "채용"
  ],
  "author": "jclee",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@resume/schemas": "*",
    "@resume/shared": "*",
    "@resume/types": "*",
    "@resume/data": "*",
    "fastify": "^5.8.4",
    "google-auth-library": "^10.9.0",
    "googleapis": "^173.0.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^8.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "puppeteer": "^24.43.0"
  },
  "optionalDependencies": {
    "@cloudflare/puppeteer": "^1.0.6"
  },
  "devDependencies": {
    "better-sqlite3": "^12.11.1",
    "playwright": "^1.58.2",
    "ws": "^8.21.0"
  }
}
