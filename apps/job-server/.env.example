# Copy to .env for local development only. Prefer .env.1password.example plus
# `npm run op:run -- --env-file .env.1password -- <command>` for real secrets.
# Keep real values in 1Password or Cloudflare Workers Secrets; never commit a
# populated .env file.

WANTED_EMAIL=you@example.com
WANTED_PASSWORD=
WANTED_ONEID_CLIENT_ID=
WANTED_RESUME_ID=

# JobKorea profile sync / auto-apply
JOBKOREA_USERNAME=
JOBKOREA_PASSWORD=
JOBKOREA_RNO=
CLIPROXY_BASE=
CLIPROXY_API_KEY=

# Optional automation integrations
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
N8N_WEBHOOK_BASE=
SLACK_WEBHOOK_URL=
