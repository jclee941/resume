# job-dashboard Worker Secrets — TEMPLATE
# Copy to .env.secrets and replace placeholders. Real file is gitignored.
#
# Generate strong values:
#   openssl rand -hex 32                    # ADMIN_TOKEN, WEBHOOK_SECRET
#   openssl rand -base64 32                 # ENCRYPTION_KEY (32-byte AES-GCM key)
#
# Production: set via `wrangler secret put NAME --config apps/job-dashboard/wrangler.jsonc`

ADMIN_TOKEN=replace_with_64char_hex_token
WEBHOOK_SECRET=replace_with_64char_hex_secret
ENCRYPTION_KEY=replace_with_base64_32byte_key
