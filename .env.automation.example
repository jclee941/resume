# Resume Automation Environment Variables
# Source this file before running automation: source .env.automation
#
# REAL VALUES MUST NOT BE COMMITTED. Load from 1Password or set in your shell.
# This file is now gitignored; copy from .env.automation.example to bootstrap.

# JobKorea Credentials (load via: op read "op://Private/JobKorea/username")
export RESUME_JOBKOREA_USER="${RESUME_JOBKOREA_USER:-}"
export RESUME_JOBKOREA_PASS="${RESUME_JOBKOREA_PASS:-}"

# Wanted Credentials
export RESUME_WANTED_EMAIL="${RESUME_WANTED_EMAIL:-}"
export RESUME_WANTED_PASS="${RESUME_WANTED_PASS:-}"

# Automation Settings
export RESUME_MAX_APPLY="${RESUME_MAX_APPLY:-5}"
export RESUME_DRY_RUN="${RESUME_DRY_RUN:-false}"

# Optional: Notification settings
# export RESUME_NOTIFY_EMAIL=your-email@example.com
# export RESUME_NOTIFY_WEBHOOK=https://hooks.slack.com/...
