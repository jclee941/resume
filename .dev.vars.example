# Cloudflare Worker local environment template
# Copy to .dev.vars and fill values for local development only.

NODE_ENV=development
SIGNING_SECRET=replace-with-local-secret
CF_API_KEY=replace-with-api-key
CF_EMAIL=replace-with-email
AUTOMATION_WEBHOOK_BASE=https://automation.example.local/webhook
ELASTICSEARCH_URL=https://elasticsearch.example.local
ELASTICSEARCH_API_KEY=replace-with-es-api-key
ELASTICSEARCH_INDEX=resume-logs-local

# === @resume/env required keys (validated at boot via packages/env) ===
# AES-GCM 256-bit symmetric key, base64-encoded (32 raw bytes).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=replace-with-base64-32-bytes
