{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "apps/portfolio/lib/**/*.js",
    "apps/portfolio/src/**/*.js",
    "apps/job-server/src/**/*.js",
    "apps/job-dashboard/src/**/*.js",
    "packages/cli/**/*.js",
    "packages/data/**/*.js",
    "packages/shared/src/**/*.js",
    "packages/types/src/**/*",
    "packages/schemas/src/**/*",
    "packages/contracts/src/**/*",
    "tools/scripts/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    "playwright-report",
    "test-results",
    "apps/portfolio/worker.js",
    "apps/portfolio/sw.js",
    "apps/portfolio/.tmp",
    "apps/portfolio/src/scripts/modules/**",
    "apps/job-server/platforms/**",
    "tests/**",
    ".wrangler",
    "**/*.test.js",
    "**/*.spec.js"
  ]
}
