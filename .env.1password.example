# 1Password environment references for resume automation.
# Values are references only. Real secrets stay in the homelab/resume item.
# Load for a command with:
#   npm run op:run -- --env-file ../../.env.1password -- <command>

WANTED_EMAIL=op://homelab/resume/WANTED_EMAIL
WANTED_PASSWORD=op://homelab/resume/WANTED_PASSWORD
WANTED_ONEID_CLIENT_ID=op://homelab/resume/WANTED_ONEID_CLIENT_ID
WANTED_RESUME_ID=op://homelab/resume/WANTED_RESUME_ID
WANTED_COOKIES=op://homelab/resume/WANTED_COOKIES

JOBKOREA_USERNAME=op://homelab/resume/JOBKOREA_USERNAME
JOBKOREA_EMAIL=op://homelab/resume/JOBKOREA_EMAIL
JOBKOREA_PASSWORD=op://homelab/resume/JOBKOREA_PASSWORD
JOBKOREA_RNO=op://homelab/resume/JOBKOREA_RNO
JOBKOREA_COOKIES=op://homelab/resume/JOBKOREA_COOKIES

CLIPROXY_BASE=op://homelab/resume/CLIPROXY_BASE
CLIPROXY_API_KEY=op://homelab/resume/CLIPROXY_API_KEY

ADMIN_TOKEN=op://homelab/resume/ADMIN_TOKEN
AUTOMATION_WEBHOOK_SECRET=op://homelab/resume/AUTOMATION_WEBHOOK_SECRET
AUTH_SYNC_SECRET=op://homelab/resume/AUTH_SYNC_SECRET
SESSION_ENCRYPTION_KEY=op://homelab/resume/SESSION_ENCRYPTION_KEY

CLOUDFLARE_ACCOUNT_ID=op://homelab/resume/CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_KEY=op://homelab/resume/CLOUDFLARE_API_KEY
CLOUDFLARE_API_TOKEN=op://homelab/resume/CLOUDFLARE_API_TOKEN
CLOUDFLARE_EMAIL=op://homelab/resume/CLOUDFLARE_EMAIL
