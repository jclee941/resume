# 1Password environment references for resume automation.
# Values are references only. Real secrets stay in the homelab/resume item.
# Load for a command with:
#   npm run op:run -- --env-file ../../.env.1password -- <command>

WANTED_EMAIL=op://homelab/resume/wanted/email
WANTED_PASSWORD=op://homelab/resume/WANTED_PASSWORD
WANTED_ONEID_CLIENT_ID=op://homelab/resume/wanted/oneid_client_id
WANTED_RESUME_ID=op://homelab/resume/wanted/resume_id

JOBKOREA_USERNAME=op://homelab/resume/jobkorea/username
JOBKOREA_EMAIL=op://homelab/resume/jobkorea/email
JOBKOREA_PASSWORD=op://homelab/resume/jobkorea/password
JOBKOREA_RNO=op://homelab/resume/JOBKOREA_RNO

CLIPROXY_BASE=op://homelab/resume/CLIPROXY_BASE
CLIPROXY_API_KEY=op://homelab/resume/CLIPROXY_API_KEY

TELEGRAM_BOT_TOKEN=op://homelab/resume/TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=op://homelab/resume/TELEGRAM_CHAT_ID

CLOUDFLARE_ACCOUNT_ID=op://homelab/resume/CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_API_KEY=op://homelab/resume/CLOUDFLARE_API_KEY
CLOUDFLARE_EMAIL=op://homelab/resume/CLOUDFLARE_EMAIL
