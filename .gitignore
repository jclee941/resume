# -----------------------------------------------------------------------------
# Resume Project - Git Ignore Patterns
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
# package-lock.json IS tracked (npm workspaces deterministic install) — do NOT ignore
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
!packages/schemas/dist/
!packages/schemas/dist/**
build/
!tools/scripts/build/
tools/scripts/build/*
!tools/scripts/build/AGENTS.md
!tools/scripts/build/pdf-generator/
!tools/scripts/build/pdf-generator/**
!tools/scripts/build/__init__.py
!tools/scripts/build/pptx_layouts.py
!tools/scripts/build/pptx_publication.py
!tools/scripts/build/pptx_ta.py
!tools/scripts/build/test_pptx_profiles.py
!tools/scripts/build/test_pptx_publication.py
*.tsbuildinfo

# Generated files — portfolio worker bundle and propagated SSoT snapshots
apps/portfolio/worker.js
apps/portfolio/data.json
apps/portfolio/data_en.json
apps/portfolio/data_ja.json
apps/portfolio/dashboard.html
apps/portfolio/dashboard.html.backup
apps/portfolio/.wrangler/
*.generated.*
*.tsbuildinfo
# NOTE: manifest*.json, sitemap.xml, og-image*.png, og-image*.webp are
# hand-maintained build inputs and SHOULD remain tracked in git — the build
# pipeline (apps/portfolio/lib/file-reader.js) reads them as required inputs.
# Earlier audit incorrectly classified them as generated; they are NOT.

# -----------------------------------------------------------------------------
# Environment files & secrets — NEVER COMMIT
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
.env.local
.env.*.local
.env.automation
.env.secrets
.env.production
.env.staging
.env.development
.dev.vars
.dev.vars.local
.dev.vars.*
!.dev.vars.example
*.secrets
*-secrets.*
# Documentation and CI tooling about secret management are committed:
!docs/**/*-secrets.*
!tools/**/*-secrets.*
*-session.json
sessions.json
jobkorea-session.json
wanted-session.json
**/cookies.json
**/credentials.json
secrets/
!apps/job-server/src/shared/clients/secrets/
!apps/job-server/src/shared/clients/secrets/**
.secrets/
# Cloudflare wrangler local secrets
.wrangler/
**/.wrangler/

# 1Password / secret manager local cache
.op-session
.env.1password
.doppler-cache
.infisical-cache
.keyflare-cache

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw browser captures may contain session cookies and form bodies
*.har
*.har.zip
**/jobkorea-har/

# Testing
coverage/
.nyc_output/

# Bazel output directories
bazel-bin
bazel-out
bazel-resume
bazel-testlogs

# -----------------------------------------------------------------------------
# Local binaries
bin/
!packages/cli/bin/
!packages/cli/bin/**

# Legacy standalone configs
lighthouserc.js

# Logs directory
logs/
# Root directory cleanup - compiled binaries (build artifacts)
/merge-ulw-to-master
/setup-automation
/verify-content-integrity
/verify-health

# Go build artifacts
/deploy-auto-apply
/deploy-workflow
/setup-api-key

# Wrangler generated types
/worker-configuration.d.ts
# Temporary session data (may contain credentials)
sessions.json

# Git artifacts
/--head=HEAD

# Local OpenCode data (large vector DB files)
.opencode/

# Tooling artifacts
.wrangler/
.playwright-mcp/
test-results/
*.backup-*
downloaded_files/
# Generated dashboards
apps/job-server/scripts/dashboard.html

# Build/temp artifacts
.tmp/
**/.tmp/
apps/portfolio/.tmp/

# 1Password secret backups (rotated values awaiting upload)
/tmp/resume-new-secrets.env
/tmp/resume-rewrite-env.sh

# Generated PDF artifacts (built via tools/scripts/build/pdf-generator.go)
# See docs/guides/PDF_GENERATION.md
# NOTE: packages/data/resumes/applications/**/*.pdf is intentionally tracked
#       as a record of submitted application materials.
apps/portfolio/downloads/*.pdf
packages/data/resumes/generated/*.pdf
packages/data/resumes/master/*.pdf
packages/data/resumes/archive/**/*.pdf
packages/data/resumes/technical/**/*.pdf
!packages/data/resumes/applications/**/*.pdf

# CI affected-detection cache (regenerated each run by tools/ci/affected.go)
.affected/
.affected-review/

# Agent tooling ephemeral state (OpenCode / Sisyphus runtime — local only, not content)
.sisyphus/*.local.md
.sisyphus/run-continuation/
.sisyphus/ulw-*.md
.omo/

# Test reports / Playwright outputs
playwright-report/
playwright-report-public/
blob-report/

# Python bytecode + local caches under ta/
ta/__pycache__/
ta/.opencode/
ta/output/
**/__pycache__/
*.pyc

# Compiled Go binaries pulled by setup scripts (act, etc.)
tools/bin/

# OpenCode local scan state (regenerated)
.opencode-scan-state
/deploy-monitoring

# Compiled Go helper (build artifact, not content)
packages/data/resumes/technical/convert-all-projects
packages/data/resumes/technical/**/convert-all-projects

# Personal job-search run outputs (candidate lists, cover-letter drafts) — local only
applications/_auto-apply-runs/
.briefing/

# Local agent/orchestration runtime state — never tracked
.omc/

# Compiled Go helper binaries (build outputs; rebuild from the adjacent *.go sources)
/tools/affected
/tools/main
/tools/ci/validate-migrations
/tools/validate-cloudflare-native
/tools/verify-agents-compliance

# Compiled Go helper binaries — all callers use `go run` against the adjacent
# *.go source, none execute these committed binaries (verified 2026-07-22)
/tools/scripts/deployment/deploy-helper
/tools/scripts/deployment/deploy-grafana-configs
/tools/scripts/deployment/deploy-with-monitoring
/tools/scripts/deployment/quick-deploy
/tools/scripts/monitoring/monitor-deployment
/apps/job-server/scripts/ops/auto-daily-run/main
/infrastructure/monitoring/elasticsearch/apply-assets
/packages/data/resumes/archive/toss/pdf-convert
/packages/data/resumes/technical/nextrade/convert-to-pdf-docx
