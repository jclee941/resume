# -----------------------------------------------------------------------------
# Resume Project - Git Ignore Patterns
# -----------------------------------------------------------------------------

# Dependencies
node_modules/
# package-lock.json IS tracked (npm workspaces deterministic install) — do NOT ignore
yarn.lock
pnpm-lock.yaml

# Build outputs
dist/
!packages/schemas/dist/
!packages/schemas/dist/**
build/
!tools/scripts/build/
tools/scripts/build/*
!tools/scripts/build/AGENTS.md
!tools/scripts/build/pdf-generator/
!tools/scripts/build/pdf-generator/**
!tools/scripts/build/*.js
!tools/scripts/build/*.go
!tools/scripts/build/*.py
!tools/scripts/build/*.tex
!tools/scripts/build/*.lua
!tools/scripts/build/requirements.txt
*.tsbuildinfo

# Generated files — portfolio worker bundle and propagated SSoT snapshots
apps/portfolio/worker.js
apps/portfolio/data.json
apps/portfolio/data_en.json
apps/portfolio/data_ja.json
tests/e2e/visual.spec.js-snapshots/
*.generated.*
# NOTE: manifest*.json and og-image*.{png,webp} are personal content-pack paths (ADR 0011);
# they are ignored by the final block. sitemap.xml remains tracked.

# -----------------------------------------------------------------------------
# Environment files & secrets — NEVER COMMIT
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
!.dev.vars.example
*.secrets
*-secrets.*
# Documentation and CI tooling about secret management are committed:
!docs/**/*-secrets.*
!tools/**/*-secrets.*
*-session.json
sessions.json
**/cookies.json
**/credentials.json
secrets/
.secrets/
# Cloudflare wrangler local secrets
.wrangler/

# 1Password / secret manager local cache
.op-session
.doppler-cache
.infisical-cache
.keyflare-cache

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Raw browser captures may contain session cookies and form bodies
*.har
*.har.zip
**/jobkorea-har/

# Testing
coverage/
.nyc_output/

# -----------------------------------------------------------------------------
# Local binaries
bin/
!packages/cli/bin/
!packages/cli/bin/**

# Logs directory
logs/
# Root directory cleanup - compiled binaries (build artifacts)
/merge-ulw-to-master

# Wrangler generated types
/worker-configuration.d.ts

# Git artifacts
/--head=HEAD

# Local OpenCode data (large vector DB files)
.opencode/

# Tooling artifacts
.playwright-mcp/
test-results/
*.backup-*
downloaded_files/
# Build/temp artifacts
.tmp/

# 1Password secret backups (rotated values awaiting upload)
/tmp/resume-new-secrets.env
/tmp/resume-rewrite-env.sh

# CI affected-detection cache (regenerated each run by tools/ci/affected/)
.affected/
.affected-review/

# Agent tooling ephemeral state (OpenCode / Sisyphus runtime — local only, not content)
.omo/

# Test reports / Playwright outputs
playwright-report/
playwright-report-public/
blob-report/

# Python bytecode + local caches under ta/
**/__pycache__/
*.pyc

# Compiled Go binaries pulled by setup scripts (act, etc.)
tools/bin/

# OpenCode local scan state (regenerated)
.opencode-scan-state
/deploy-monitoring

# Personal job-search briefings — local only
.briefing/

# Local agent/orchestration runtime state — never tracked
.omc/

# Compiled Go helper binaries (build outputs; rebuild from the adjacent *.go sources)
/tools/affected
/tools/main
/tools/ci/validate-migrations
/tools/validate-cloudflare-native
/tools/verify-agents-compliance

# Compiled Go helper binaries — all callers use `go run` against the adjacent
# *.go source, none execute these committed binaries (verified 2026-07-22)
/tools/scripts/deployment/deploy-helper/deploy-helper
/tools/scripts/deployment/deploy-grafana-configs/deploy-grafana-configs
/tools/scripts/deployment/deploy-with-monitoring
/tools/scripts/deployment/quick-deploy
/tools/scripts/monitoring/monitor-deployment
/infrastructure/monitoring/elasticsearch/apply-assets

# Materialized personal content pack manifest (ADR 0011)
.content/

# Personal content pack paths (ADR 0011): materialized from D1, never committed. Mirrors the
# include/exclude globs of tools/scripts/content/content-pack.json; tests/fixtures/content-pack/
# holds the tracked fake pack. Later rules win, so this block stays last.
/packages/data/resumes/**
/applications/**
/ta/**
/.sisyphus/**
/apps/portfolio/index.html
/apps/portfolio/index-en.html
/apps/portfolio/lib/hero-content-data.js
/apps/portfolio/lib/skill-radar-data.js
/apps/portfolio/src/scripts/modules/*-data.js
/apps/portfolio/manifest*.json
/apps/portfolio/og-image*.png
/apps/portfolio/og-image*.webp
/apps/portfolio/assets/profile-photo.jpg
/apps/portfolio/assets/resume*.pdf
/apps/portfolio/assets/social/og-image*.png
/apps/portfolio/downloads/**
/ProfileView.jpg
# Keep directories traversable so the exceptions below can re-include files inside them.
!/packages/data/resumes/**/
!/applications/**/
!/ta/**/
!/.sisyphus/**/
!/apps/portfolio/downloads/**/
# Not content: agent guides, the resume schema, and directory placeholders stay tracked.
!**/AGENTS.md
!/packages/data/resumes/master/resume_schema.json
!**/.gitkeep
