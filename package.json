{
  "name": "resume",
  "version": "1.40.12",
  "description": "Portfolio automation workspace: Cloudflare Worker edge site, job automation (Wanted/JobKorea), SSoT data, self-hosted observability",
  "main": "apps/portfolio/worker.js",
  "private": true,
  "workspaces": [
    "apps/portfolio",
    "apps/job-dashboard",
    "packages/cli",
    "packages/data",
    "packages/shared",
    "packages/types",
    "packages/schemas",
    "packages/contracts",
    "packages/env"
  ],
  "scripts": {
    "strip-exif": "exiftool -all= -overwrite_original apps/portfolio/src/images/*.png apps/portfolio/src/images/*.webp 2>/dev/null || echo 'exiftool not found - skipping'",
    "sync:data": "node tools/scripts/utils/sync-resume-data.js",
    "sync:pptx": "python3 tools/scripts/build/generate_ta_pptx.py",
    "sync:pdf": "go -C tools/scripts run ./build/pdf-generator master && go -C tools/scripts run ./build/pdf-generator full",
    "sync:all": "npm run sync:data && npm run sync:pdf && npm run sync:pptx",
    "op:run": "cd tools/scripts && go run ./onepassword/run",
    "op:native:run": "cd tools/scripts && go run ./onepassword/native-run",
    "op:seed:resume": "cd tools/scripts && go run ./onepassword/seed-resume",
    "sync:proposals": "go -C tools/scripts run ./sync",
    "enrich:github": "cd tools/scripts/enrichment/github && go run main.go",
    "enrich:skills": "cd tools/scripts/enrichment/skills && go run .",
    "enrich:ai": "cd tools/scripts/enrichment/ai && go run main.go",
    "enrich:all": "npm run enrich:github && npm run enrich:ai",
    "automate:ssot": "npm run sync:pdf && npm run build && npm run typecheck",
    "automate:full": "npm run sync:pdf && npm run sync:pptx && npm run build && npm run lint && npm run typecheck && npm run test && go run ./tools/ci/validate-cloudflare-native.go",
    "build": "node tools/scripts/content/cli.mjs ensure && npm run sync:data && npm run build:worker",
    "build:worker": "npm run build --workspace=@resume/portfolio-worker",
    "build:portfolio": "npm run build",
    "build:full": "npm run build && npm run cli:build",
    "build:all": "npm run build:full",
    "version:bump": "npm version patch --no-git-tag-version",
    "deploy": "node -e \"console.error('Manual deploy is disabled. Use git push to master for Cloudflare Workers Builds.'); process.exit(1)\"",
    "cli:build": "echo 'No build needed for Node CLI'",
    "cli:verify": "node packages/cli/bin/run.js verify",
    "test": "npm run test:jest && npm run test:dashboard && npm run test:schemas && npm run test:shared && npm run test:tools && npm run test:cli && npm run test:python && npm run test:go",
    "test:jest": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:dashboard": "node --test 'apps/job-dashboard/src/**/__tests__/*.test.js' 'apps/job-dashboard/src/**/__tests__/*.test.mjs'",
    "test:go": "GO111MODULE=off go -C tools/ci/affected test . && GO111MODULE=off go -C tools/ci test validate-migrations.go validate_migrations_test.go && go -C tools/scripts test ./release/publish ./release/next-version ./build/pdf-generator ./sync ./onepassword/native-run ./verification/wait-for-deployment && go -C tools/scripts/enrichment test ./...",
    "test:python": "python3 -m unittest discover -s tools/scripts/build -p 'test_pptx_*.py'",
    "test:schemas": "node --test 'packages/schemas/src/__tests__/**/*.test.js' 'packages/env/src/__tests__/**/*.test.js'",
    "test:shared": "node --test 'packages/shared/src/**/__tests__/*.test.js'",
    "test:tools": "node --test 'tools/scripts/**/__tests__/**/*.test.{js,mjs}'",
    "content:ensure": "node tools/scripts/content/cli.mjs ensure",
    "content:pull": "node tools/scripts/content/cli.mjs pull",
    "content:push": "node tools/scripts/content/cli.mjs push",
    "content:status": "node tools/scripts/content/cli.mjs status",
    "content:manifest": "node tools/scripts/content/cli.mjs manifest",
    "content:guard": "node tools/scripts/content/cli.mjs guard",
    "test:cli": "node --test 'packages/cli/src/__tests__/**/*.test.js'",
    "test:coverage": "npm run test:coverage:jest",
    "test:coverage:jest": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:worker": "npx playwright test worker-health --project=chromium",
    "test:e2e:deploy": "npx playwright test deploy-verification --project=chromium",
    "test:e2e:smoke": "npx playwright test worker-health deploy-verification --project=chromium",
    "verify:production": "SKIP_WEBSERVER=1 PLAYWRIGHT_BASE_URL=https://resume.jclee.me npx playwright test deploy-verification --project=chromium",
    "lighthouse:ci": "node tools/scripts/verification/run-lighthouse-ci.mjs --config=tools/lighthouserc.json",
    "security:audit": "node tools/scripts/verification/audit-production-dependencies.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "validate:openapi": "redocly lint packages/contracts/openapi.yaml",
    "lint:agents": "go run tools/scripts/verification/verify-agents-compliance.go",
    "verify:all": "npm run verify:production",
    "lint:naming": "node tools/scripts/verification/validate-monorepo-naming.mjs",
    "lint:loc": "node tools/scripts/verification/check-source-loc.mjs",
    "hooks:install": "pre-commit install",
    "hooks:run": "pre-commit run --all-files",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:workspace-deps": "node tools/scripts/verification/validate-workspace-dependencies.mjs",
    "verify:worker-config": "node tools/scripts/verification/validate-worker-config.mjs",
    "verify:ssot": "node tools/scripts/utils/verify-resume-sync.mjs",
    "verify:architecture-governance": "node tools/scripts/verification/validate-architecture-docs.mjs --governance-only",
    "verify:architecture-hardening:core": "npm run verify:worker-config && npm run verify:ssot && npm run verify:workspace-deps && npm run verify:architecture-governance",
    "dev": "CLOUDFLARE_ENV= wrangler dev --config wrangler.jsonc --port 8787 --local",
    "foreign-apply:dry-run": "node apps/job-dashboard/scripts/dev/foreign-apply-dry-run.mjs",
    "dev:wrangler": "npm run dev",
    "deploy:wrangler:root": "npm run build:full && CLOUDFLARE_ENV= wrangler deploy --config wrangler.jsonc",
    "deploy:wrangler:root:dry-run": "npm run build:full && CLOUDFLARE_ENV= wrangler deploy --config wrangler.jsonc --dry-run"
  },
  "keywords": [
    "resume",
    "portfolio",
    "cloudflare-workers",
    "jamstack"
  ],
  "author": "jclee941 (https://github.com/jclee941)",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@redocly/cli": "^2.41.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.2",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.59.1",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "html-minifier-terser": "^7.2.0",
    "jest": "^30.4.2",
    "jsonc-parser": "^3.3.1",
    "lighthouse": "^13.4.1",
    "prettier": "^3.9.5",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "wrangler": "^4.146.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "@cloudflare/puppeteer": {
      "@puppeteer/browsers": "^3.2.2"
    },
    "semver": "^7.6.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
